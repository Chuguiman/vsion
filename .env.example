# ── Base de datos (Supabase Postgres) — opcional para historial ──────────
# Sin esto la app corre igual pero no guarda historial.
DATABASE_URL=postgres://postgres:...@db.xxxx.supabase.co:5432/postgres?sslmode=require

# ── Supabase Storage (Fase 3: imágenes de publicaciones) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── IA (Fase 2) — OpenRouter ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Modelos verificados que funcionan en esta cuenta (usar el slug EXACTO):
#   openai/gpt-4o-mini      (rápido y barato — recomendado)
#   google/gemini-2.5-flash (muy rápido, algo más caro)
#   deepseek/deepseek-chat  (barato pero lento)
# Ojo: slugs como google/gemini-2.0-flash-001 dan 404 "No endpoints found".
AI_MODEL=openai/gpt-4o-mini
# DeepSeek/OpenRouter rate-limitea a valores altos; 6-8 es lo más estable.
AI_CONCURRENCY=8
