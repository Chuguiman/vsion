# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Modelo revisor (cualquiera de OpenRouter). Recomendados por coste/calidad:
#   deepseek/deepseek-chat        (muy barato)
#   openai/gpt-4o-mini            (barato, sólido)
#   anthropic/claude-3.5-sonnet   (mejor razonamiento legal, más caro)
AI_MODEL=deepseek/deepseek-chat

# Concurrencia de llamadas IA. DeepSeek/OpenRouter rate-limitea a valores altos;
# 6-8 es lo más estable. Los fallos transitorios se recuperan re-corriendo
# el mismo comando (el cache salta lo ya resuelto).
AI_CONCURRENCY=8
